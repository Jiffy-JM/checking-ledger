# Copy this to .env and fill it in:   cp .env.example .env

# Your server's address on your home network. The app answers only here.
HOST_IP=127.0.0.1
HOST_PORT=3000

# The owner of this folder on the server. Run `id -u` and `id -g` there.
PUID=1000
PGID=1000

# Decides what "today" is.
TZ=America/New_York

# Anyone on your network can reach the app, so set a long password.
APP_PASSWORD=

# Recommended: the addresses you open the app at, separated by commas, like
# 192.168.1.50,ledger.local. Requests for any other address are refused,
# which stops a web page elsewhere from reaching the app through your browser.
# Leave blank to accept any address.
ALLOWED_HOSTS=

# The look every browser starts with. Each browser can pick its own on the
# Theme page. Themes: sage, indigo, violet, neon, orchid, ocean, gold, synth, teal, ember, mist, ultra,
# ink, grape.
# THEME_MODE is auto (match the device), light, or dark.
THEME=ember
THEME_MODE=dark

# Leave blank to build the app on this machine. To run a published image,
# put its full name here, ending in its digest (see docs/PUBLISHING.md):
#   LEDGER_IMAGE=ghcr.io/jiffy-jm/checking-ledger@sha256:...
LEDGER_IMAGE=
