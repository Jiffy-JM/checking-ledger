# Settings for the optional cloud backup service.
# Copy this to backup.env and fill it in:   cp backup.env.example backup.env
# Only the backup container reads this file. The app never sees these values.

# Where the encrypted backups go. For Cloudflare R2:
#   s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/checking-ledger
# Your account ID is on the R2 overview page in the Cloudflare dashboard.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET/checking-ledger

# An R2 API token limited to "Object Read & Write" on that one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The encryption password, at least 20 characters. Everything is encrypted
# with it before upload. WRITE IT DOWN SOMEWHERE ELSE (a password manager):
# if this server dies and you don't have it, the backups can't be opened.
RESTIC_PASSWORD=

# When to back up each day (24-hour clock, in the TZ from .env).
BACKUP_TIME=03:15

# How many backups to keep.
KEEP_DAILY=30
KEEP_WEEKLY=12
KEEP_MONTHLY=24
